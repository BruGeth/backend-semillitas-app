					},
					"response": []
				},
				{
					"name": "Login - Credenciales inválidas (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Responde 401 Credenciales inválidas\", function () {",
									"    pm.response.to.have.status(401);",
									"    var data = pm.response.json();",
									"    pm.expect(data.error).to.eql(\"Credenciales inválidas\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dni\": \"12345678\",\n  \"password\": \"clave_incorrecta\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Prueba de autenticación fallida (debe registrar intento fallido en tabla auditoria)."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Matrículas y Niños",
			"item": [
				{
					"name": "Registrar Preinscripción (Directora)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dniNino\": \"70123456\",\n  \"nombres\": \"Mateo\",\n  \"apellidos\": \"Pérez Gómez\",\n  \"fechaNacimiento\": \"2021-05-10\",\n  \"dniApoderado\": \"11223344\"\n}"
						},
