				{
					"name": "Login - Credenciales inválidas (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Responde 401 Credenciales inválidas\", function () {",
									"    pm.response.to.have.status(401);",
									"    var data = pm.response.json();",
									"    pm.expect(data.error).to.eql(\"Credenciales inválidas\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
