{
	"info": {
		"_postman_id": "b3e04cf4-7d52-4a0b-85d1-92576bbf8241",
		"name": "Semillitas Backend API",
		"description": "Colección completa de endpoints para el backend del nido Semillitas.\n\n### Autenticación\nAl ejecutar cualquiera de las peticiones de **Login**, el script de prueba guarda automáticamente el JWT en la variable `{{token}}` de la colección, permitiendo ejecutar las peticiones protegidas sin tener que copiar y pegar el token manualmente.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticación",
			"item": [
				{
					"name": "Login - Directora (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    pm.collectionVariables.set(\"token\", data.token);",
									"    pm.test(\"Login exitoso y token guardado\", function () {",
									"        pm.expect(data.token).to.be.a('string');",
									"        pm.expect(data.user.role).to.eql('directora');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dni\": \"12345678\",\n  \"password\": \"semillitas123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión como Directora. Guarda el JWT automáticamente en la variable {{token}}."
					},
					"response": []
				},
				{
