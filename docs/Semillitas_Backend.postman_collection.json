									"    pm.test(\"Login exitoso como Padre\", function () {",
									"        pm.expect(data.token).to.be.a('string');",
									"        pm.expect(data.user.role).to.eql('padre');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
