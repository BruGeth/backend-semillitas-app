								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/matriculas/ninos?texto=Mateo",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"matriculas",
								"ninos"
							],
							"query": [
								{
									"key": "texto",
									"value": "Mateo",
									"description": "Filtra por nombre, apellido o DNI"
								}
							]
						},
						"description": "Búsqueda parametrizada con prevención de SQL Injection."
					},
					"response": []
				}
			]
		},
